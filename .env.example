# Neon / Vercel Postgres connection string
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Random 32+ char string used to sign session cookies
SESSION_SECRET=""

# Random 32+ char string. Must match the value in worker/.env exactly.
# Used to authenticate requests from your local processing worker.
WORKER_SECRET=""

# --- Everything below is currently unused ---
# AI processing now runs on your local machine via worker/ (see worker/.env.example),
# not on Vercel. These are only needed if you later switch back to push-based
# processing via QStash calling /api/jobs/process directly.

# OPENAI_API_KEY=""
# AI_BASE_URL=""
# AI_MODEL=""
# APP_URL=""
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
# QSTASH_TOKEN=""
# QSTASH_CURRENT_SIGNING_KEY=""
# QSTASH_NEXT_SIGNING_KEY=""
