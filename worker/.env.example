# Your deployed Vercel URL (no trailing slash)
SERVER_URL="https://human-pain-intelligence.vercel.app"

# Must match WORKER_SECRET set in Vercel's env vars exactly
WORKER_SECRET=""

# LM Studio's OpenAI-compatible endpoint. /v1 suffix required.
AI_BASE_URL="http://localhost:1234/v1"
# Leave AI_MODEL unset/blank to auto-use whatever model is currently loaded in LM Studio.
AI_MODEL=

# Embedding model used for semantic clustering (grouping similar problems together).
# Must be set explicitly — LM Studio's model list doesn't distinguish chat vs
# embedding models, so auto-detection isn't reliable here. If unset, clustering
# is skipped and every submission becomes its own problem cluster.
EMBEDDING_MODEL="text-embedding-nomic-embed-text-v1.5"

# LM Studio's API key, from Developer > Server Settings > Manage Tokens
OPENAI_API_KEY=""

# How often to poll for new work, and how many jobs to grab per poll
POLL_INTERVAL_MS=10000
BATCH_SIZE=5
